struct TLB_Entry = {
  asid       : asidbits,           // comment
  global     : bool,               // comment
  vpn        : bits(tlb_vpn_bits), // comment
  levelMask  : bits(tlb_vpn_bits), // comment
  ppn        : bits(tlb_ppn_bits), // comment
  pte        : bits(64),           // comment
  pteAddr    : physaddr,           // comment
}

